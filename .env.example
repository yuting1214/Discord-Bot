# Copy to .env and fill in. Never commit .env.

# Application
ENV_MODE=dev          # dev | prod

# Discord bot token — Discord Developer Portal -> Applications -> Bot -> Token
DISCORD_TOKEN=

# LLM providers — set the key for whichever provider you select below
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# LLM routing. Models are env-overridable so the template does not go stale
# when a provider ships a newer model.
LLM_PROVIDER=openai              # openai | openrouter
OPENAI_MODEL=gpt-5.6-luna
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Leave unset for the model's own default. Reasoning models (including the
# default gpt-5.6-luna) reject any other value; if you set one and the model
# refuses it, the request is retried without it.
LLM_TEMPERATURE=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Reasoning. Sent as OpenRouter's `reasoning` body field, so it applies to
# LLM_PROVIDER=openrouter; the returned reasoning trace is stored per message
# and replayed on the next turn so the model resumes instead of restarting.
LLM_REASONING=true

# Authentication (protects /docs and /redoc)
# Leave empty to auto-generate — credentials are printed in the startup logs.
USER_NAME=
PASSWORD=

# Signs session cookies. Leave empty to auto-generate on each start (sessions
# reset on restart); set a stable random string to keep them across deploys.
SECRET_KEY=

# Search (/search and /search_group). Runs on pgvector inside the PostgreSQL
# service, so there is nothing extra to deploy. Embeddings use OPENAI_API_KEY.
# Changing the model means changing EMBEDDING_DIM and re-embedding stored rows.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
SEARCH_TOP_N=5                   # results shown; the total matched is reported too
SEARCH_SEMANTIC_RATIO=0.5        # 1.0 = pure semantic, 0.0 = pure keyword

# Database (prod only — dev mode uses SQLite at ./dev.db)
DB_ENGINE=postgresql
DB_USERNAME=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Alternative: single connection string (overrides the individual DB_* vars above)
DATABASE_URL=

# Public base URL of this service (prod only)
HOST_URL=

# Server
PORT=5000
