# Copy to .env and fill in. Never commit .env.

# Application
ENV_MODE=dev          # dev | prod

# Discord bot token — Discord Developer Portal -> Applications -> Bot -> Token
DISCORD_TOKEN=

# LLM providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Authentication (protects /docs and /redoc)
USER_NAME=
PASSWORD=

# Meilisearch (powers /search and /search_group)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# Database (prod only — dev mode uses SQLite at ./dev.db)
DB_ENGINE=postgresql
DB_USERNAME=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Alternative: single connection string (overrides the individual DB_* vars above)
DATABASE_URL=

# Public base URL of this service (prod only)
HOST_URL=

# Server
PORT=5000
